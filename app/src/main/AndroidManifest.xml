        <activity
            android:name=".ui.activities.showcase_activities.overview.admin.ShowcaseSubscriberListActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activities.showcase_activities.stories.StoriesViewerListActivity"
