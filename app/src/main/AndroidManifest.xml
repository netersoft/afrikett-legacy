            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".ui.activities.others_activities.settings.ProfileSettingsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activities.messenger_activities.ContactActivity"
            android:screenOrientation="portrait"
            android:theme="@style/SkyblueOverflowButtonTheme" />
        <activity
            android:name=".ui.activities.messenger_activities.ChatBoxActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
