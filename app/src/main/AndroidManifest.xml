<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.neteru.afrikett">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".core.Root"
        android:allowBackup="true"
        android:icon="@mipmap/afrikett_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/afrikett_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="AllowBackup,GoogleAppIndexingWarning">
        <activity android:name=".ui.activities.others_activities.OutdatedVersionActivity"></activity>
        <activity android:name=".ui.activities.others_activities.help.PrivacyPolicyActivity" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="com.google.android.maps.v2.API_KEY"
            android:value="@string/api_key" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <activity
            android:name=".ui.activities.launch_activities.splash.SplashActivity"
            android:screenOrientation="portrait"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.schibstedspain.leku.LocationPickerActivity"
            android:label="@string/leku_title_activity_location_picker"
            android:parentActivityName=".ui.activities.main_activities.HomeActivity"
            android:theme="@style/LocationPickerTheme"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/leku_searchable" />
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.activities.main_activities.HomeActivity" />
        </activity>
        <activity
            android:name=".ui.activities.launch_activities.intro.IntroActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.FullScreen" />
        <activity
            android:name=".ui.activities.launch_activities.start.phone.GetPhoneNumberActivity"
            android:screenOrientation="portrait"
            android:theme="@style/BlueAppThemeOverlay" />
        <activity
            android:name=".ui.activities.main_activities.HomeActivity"
            android:label="@string/title_activity_main"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".ui.activities.showcase_activities.AddActivity"
            android:screenOrientation="portrait"
            android:theme="@style/BlueAppThemeOverlay" />
        <activity
            android:name=".ui.activities.showcase_activities.ManageActivity"
            android:screenOrientation="portrait"
            android:theme="@style/BlueAppThemeOverlay" />
        <activity
            android:name=".ui.activities.others_activities.settings.GeneralSettingsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activities.others_activities.HelpActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activities.others_activities.AboutActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".ui.activities.launch_activities.start.phone.ValidationActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".ui.activities.launch_activities.start.phone.InfoActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".ui.activities.showcase_activities.registration.FirstStepActivity"
            android:screenOrientation="portrait"
            android:theme="@style/OrangeAppThemeOverlay"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.activities.showcase_activities.registration.SecondStepActivity"
            android:screenOrientation="portrait"
            android:theme="@style/BlueAppThemeOverlay"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.activities.showcase_activities.registration.ThirdStepActivity"
            android:screenOrientation="portrait"
            android:theme="@style/OrangeAppThemeOverlay"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.activities.showcase_activities.registration.FourthStepActivity"
            android:screenOrientation="portrait"
            android:theme="@style/BlueAppThemeOverlay"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.theartofdev.edmodo.cropper.CropImageActivity"
