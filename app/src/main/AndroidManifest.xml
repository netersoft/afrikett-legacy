        <activity
            android:name=".ui.activities.showcase_activities.overview.admin.settings.ShowcaseVisualSettingsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activities.showcase_activities.overview.admin.settings.ShowcaseInfoSettingsActivity"
