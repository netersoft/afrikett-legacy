<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- No Action Bar Themes -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBarBlack">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimaryDark">@color/black</item>
    </style>

    <!-- Fullscreen Theme -->
    <style name="AppTheme.FullScreen" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Splash Theme -->
    <style name="SplashTheme" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">
            @drawable/launch_screen
        </item>
    </style>

    <!-- Skyblue Overflow Button Theme -->
    <style name="SkyblueOverflowButtonTheme" parent="AppTheme">
        <item name="actionOverflowButtonStyle">@style/OverflowButtonStyle</item>
        <item name="android:actionOverflowButtonStyle">@style/OverflowButtonStyle</item>
    </style>

    <style name="OverflowButtonStyle" parent="@style/Widget.AppCompat.Light.ActionButton.Overflow">
        <item name="android:src">@mipmap/ic_more_vert_white_24dp</item>
        <item name="android:tint">@color/skyblue</item>
    </style>

    <!-- Overlay Themes -->
    <style name="BlueAppThemeOverlay" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:actionBarStyle">@style/MyActionBar</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!--For compatibility-->
        <item name="actionBarStyle">@style/MyActionBar</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="colorPrimaryDark">@color/colorPrimary</item>
    </style>

    <style name="OrangeAppThemeOverlay" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:actionBarStyle">@style/MyActionBar</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!--For compatibility-->
        <item name="actionBarStyle">@style/MyActionBar</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="colorPrimaryDark">@color/darkorange</item>
    </style>

    <style name="BlackAppThemeOverlay" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:actionBarStyle">@style/MyActionBar</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!--For compatibility-->
        <item name="actionBarStyle">@style/MyActionBar</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="colorPrimaryDark">@color/black</item>
    </style>

    <style name="MyActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="android:background">@color/transparent</item>
        <!--For compatibility-->
        <item name="background">@color/transparent</item>
    </style>

    <!-- Bottom Sheet Dialog -->
    <style name="BottomSheetStyle" parent="@style/BottomSheet">
        <item name="bottom_sheet_bg_color">@color/skyblue</item>
        <item name="bottom_sheet_title_text_appearance">@style/TitleAppearance</item>
        <item name="bottom_sheet_list_text_appearance">@style/ListAppearance</item>
        <item name="bottom_sheet_grid_text_appearance">@style/GridAppearance</item>
        <item name="bottom_sheet_item_icon_color">@color/white</item>
    </style>

    <style name="TitleAppearance" parent="BottomSheet.Title.TextAppearance">
        <item name="android:textColor">@color/silver</item>
    </style>

    <style name="ListAppearance" parent="BottomSheet.ListItem.TextAppearance">
        <item name="android:textColor">@color/gray</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="GridAppearance" parent="BottomSheet.GridItem.TextAppearance">
        <item name="android:textColor">@color/whitesmoke</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Image Picker Theme -->
    <style name="ImagePickerTheme" parent="ef_BaseTheme">
        <item name="colorPrimary">@color/dodgerblue</item>
        <item name="colorPrimaryDark">@color/skyblue</item>
        <item name="colorAccent">@color/whitesmoke</item>
    </style>

    <!-- Contact Picker Theme -->
    <style name="ContactPickerTheme" parent="MultiContactPicker.Azure">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="mcpToolbarTheme">@style/MyContactPickerToolbarTheme</item>
        <item name="mcpListPopupWindowStyleTheme">@style/MyContactPickerToolbarTheme</item>
    </style>

    <style name="MyContactPickerToolbarTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/colorPrimary</item>
        <item name="android:textColorSecondary">@color/colorPrimaryDark</item>
    </style>

    <!-- Switch -->
    <style name="switchStyle" parent="Theme.AppCompat.Light">
        <!-- active thumb & track color (30% transparency) -->
        <item name="colorControlActivated">@color/skyblue</item>

        <!-- inactive thumb color
        <item name="colorSwitchThumbNormal">@color/silver</item> -->

        <!-- inactive track color (30% transparency)
        <item name="android:colorForeground">@color/gray</item> -->
    </style>

    <!-- StateView theme -->
    <style name="StatusPage" />

    <style name="StatusPage.title" parent="@android:style/TextAppearance.Medium" />

    <style name="StatusPage.description" parent="@android:style/TextAppearance.Small" />

    <!-- Date Picker -->
    <style name="DatePickerStyle">
        <item name="android:textSize">22sp</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:colorControlNormal" tools:targetApi="lollipop">@color/orange</item>
    </style>

    <!-- Location Picker -->
    <style name="LocationPickerTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
    </style>

    <!-- Photo Editor EditText -->
    <style name="PhotoEditorEditText">
        <item name="android:singleLine">true</item>
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="colorControlActivated">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Time Picker -->
    <style name="TimePickerStyle" parent="@style/ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="colorAccent">@color/colorPrimary</item>
    </style>

</resources>
