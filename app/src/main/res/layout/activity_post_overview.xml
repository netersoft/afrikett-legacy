<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/whitesmoke">

    <com.google.android.material.appbar.AppBarLayout
        app:elevation="@dimen/zero_dp"
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/AppTheme.PopupOverlay">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/title"
                    android:textColor="@color/skyblue"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="start|center_vertical"
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"/>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/app_bar_layout">

        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="125dp">

            <LinearLayout
                android:id="@+id/header"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/eight_dp"
                android:paddingBottom="@dimen/eight_dp">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/desc"
                    android:layout_marginLeft="@dimen/ten_dp"
                    android:layout_marginStart="@dimen/ten_dp"/>

                <LinearLayout
                    android:paddingTop="2.5dp"
                    android:paddingBottom="2.5dp"
                    android:orientation="vertical"
                    android:layout_marginLeft="@dimen/ten_dp"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/name"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@+id/options"
                            android:layout_toLeftOf="@+id/options"/>

                        <ImageView
                            android:id="@+id/options"
                            android:tint="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentRight="true"
                            android:layout_marginEnd="@dimen/ten_dp"
                            android:layout_marginRight="@dimen/ten_dp"
                            app:srcCompat="@mipmap/ic_more_vert_white_24dp"
                            tools:ignore="ContentDescription" />

                    </RelativeLayout>

                    <TextView
                        android:text="@string/has_published"
                        android:textSize="13sp"
                        android:textColor="@color/gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/current_margin"
                android:layout_marginLeft="@dimen/current_margin"
                android:layout_marginStart="@dimen/current_margin"
                android:layout_marginEnd="@dimen/current_margin"
                android:layout_marginRight="@dimen/current_margin">

                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/product_and_service"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        tools:ignore="UseCompoundDrawables">

                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/dimgray"
                            android:id="@+id/product_or_service_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/three_dp"
                            android:layout_marginRight="@dimen/three_dp"
                            android:textAppearance="@style/TextAppearance.AppCompat.Medium"/>

                        <ImageView
                            android:tint="@color/limegreen"
                            android:paddingTop="@dimen/three_dp"
                            android:id="@+id/product_or_service_availability"
                            app:srcCompat="@mipmap/ic_brightness_1_white_24dp"
                            android:layout_width="@dimen/ten_dp"
                            android:layout_height="@dimen/ten_dp"
                            tools:ignore="ContentDescription" />

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/five_dp"
                        android:gravity="center_vertical"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:tint="@color/dimgray"
                            app:srcCompat="@mipmap/baseline_arrow_right_white_18"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/product_or_service_price"
                            android:textColor="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                    </LinearLayout>

                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/product_or_service_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/event"
                    android:visibility="gone"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/event_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"/>

                    <TextView
                        android:gravity="bottom"
                        android:id="@+id/event_location"
                        android:textColor="@color/dimgray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/one_dp"
                        android:drawableLeft="@mipmap/ic_place_white_24dp"
                        android:drawableStart="@mipmap/ic_place_white_24dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/event_date"
                            android:textColor="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/one_dp"
                            android:layout_marginEnd="@dimen/current_margin"
                            android:layout_marginRight="@dimen/current_margin"
                            android:drawableLeft="@mipmap/ic_date_range_white_24dp"
                            android:drawableStart="@mipmap/ic_date_range_white_24dp"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                        <TextView
                            android:id="@+id/event_hour"
                            android:textColor="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/one_dp"
                            android:drawableLeft="@mipmap/ic_schedule_white_24dp"
                            android:drawableStart="@mipmap/ic_schedule_white_24dp"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/event_about"
                        android:textColor="@color/dimgray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/news"
                    android:visibility="gone"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/news_title"
                        android:textColor="@color/dimgray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"/>

                    <TextView
                        android:id="@+id/news_content"
                        android:textColor="@color/dimgray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                    <TextView
                        android:id="@+id/news_date"
                        android:textColor="@color/gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                </LinearLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/aa"
                        android:scaleType="centerCrop"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/b"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1">

                    <ImageView
                        android:id="@+id/ba"
                        android:layout_weight="0.5"
                        android:scaleType="centerCrop"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/bb"
                        android:layout_weight="0.5"
                        android:scaleType="centerCrop"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/c"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1">

                    <ImageView
                        android:id="@+id/ca"
                        android:layout_weight="0.5"
                        android:layout_width="0dp"
                        android:scaleType="centerCrop"
                        android:layout_height="match_parent"
                        tools:ignore="ContentDescription" />

                    <TableLayout
                        android:id="@+id/cb"
                        android:orientation="vertical"
                        android:layout_weight="0.5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/cba"
                            android:layout_weight="0.5"
                            android:scaleType="centerCrop"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            tools:ignore="ContentDescription" />

                        <RelativeLayout
                            android:id="@+id/cbb"
                            android:layout_weight="0.5"
                            android:layout_width="match_parent"
                            android:layout_height="0dp">

                            <ImageView
                                android:id="@+id/cbba"
                                android:scaleType="centerCrop"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:id="@+id/cbbb"
                                android:gravity="center"
                                android:visibility="gone"
                                android:textAlignment="center"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/transparent_black_hex_33"
                                style="@style/TextAppearance.AppCompat.Medium"/>

                        </RelativeLayout>

                    </TableLayout>

                </LinearLayout>

                <TableLayout
                    android:id="@+id/d"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1">

                    <ImageView
                        android:id="@+id/da"
                        android:layout_weight="0.6"
                        android:scaleType="centerCrop"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:id="@+id/db"
                        android:layout_weight="0.4"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="0dp">

                        <ImageView
                            android:id="@+id/dba"
                            android:layout_weight="0.3"
                            android:layout_width="0dp"
                            android:scaleType="centerCrop"
                            android:layout_height="match_parent"
                            tools:ignore="ContentDescription" />

                        <ImageView
                            android:id="@+id/dbb"
                            android:layout_weight="0.3"
                            android:layout_width="0dp"
                            android:scaleType="centerCrop"
                            android:layout_height="match_parent"
                            tools:ignore="ContentDescription" />

                        <ImageView
                            android:id="@+id/dbc"
                            android:layout_weight="0.3"
                            android:layout_width="0dp"
                            android:scaleType="centerCrop"
                            android:layout_height="match_parent"
                            tools:ignore="ContentDescription" />

                    </LinearLayout>

                </TableLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentLeft="true"
                    android:layout_margin="@dimen/current_margin"
                    tools:ignore="RelativeOverlap">

                    <ImageView
                        android:tint="@color/dimgray"
                        android:id="@+id/action_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@mipmap/ic_star_border_white_24dp"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:paddingTop="2.5dp"
                        android:id="@+id/rating_counter"
                        android:gravity="center_vertical"
                        android:textColor="@color/dimgray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/two_dp"
                        android:layout_marginStart="@dimen/two_dp"
                        android:layout_marginEnd="@dimen/current_margin"
                        android:layout_marginRight="@dimen/current_margin" />

                    <ImageView
                        android:paddingTop="2.5dp"
                        android:tint="@color/dimgray"
                        android:id="@+id/action_comment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/five_dp"
                        android:layout_marginStart="@dimen/five_dp"
                        app:srcCompat="@mipmap/ic_comment_white_24dp"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:paddingTop="2.5dp"
                        android:id="@+id/comment_counter"
                        android:gravity="center_vertical"
                        android:textColor="@color/dimgray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/two_dp"
                        android:layout_marginStart="@dimen/two_dp"/>

                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_margin="@dimen/current_margin"
                    tools:ignore="RelativeOverlap">

                    <ImageView
                        android:id="@+id/action_contact"
                        android:tint="@color/dimgray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/current_margin_2"
                        android:layout_marginRight="@dimen/current_margin_2"
                        app:srcCompat="@mipmap/outline_email_white_24"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/action_save"
                        android:tint="@color/dimgray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/current_margin_2"
                        android:layout_marginRight="@dimen/current_margin_2"
                        app:srcCompat="@mipmap/ic_bookmark_border_white_24dp"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/action_share"
                        android:tint="@color/dimgray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@mipmap/ic_share_white_24dp"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

            </RelativeLayout>

            <View
                android:background="@color/gray"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/comments_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:dividerHeight="@dimen/three_dp"
                android:scrollbarThumbVertical="@android:color/transparent"/>

            <TextView
                android:visibility="gone"
                android:id="@+id/no_comment"
                android:textAlignment="center"
                android:text="@string/no_opinion"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/whitesmoke"
                android:paddingTop="@dimen/current_margin_2"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:gravity="center"
        android:id="@+id/bottom_editor"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/five_dp"
        android:paddingStart="@dimen/five_dp"
        android:paddingEnd="@dimen/five_dp"
        android:paddingRight="@dimen/five_dp"
        android:paddingBottom="@dimen/eight_dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/zero_dp"
            android:layout_weight=".70"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/five_dp"
            android:layout_marginEnd="@dimen/five_dp"
            android:layout_marginBottom="@dimen/one_dp"
            android:layout_marginTop="@dimen/one_dp"
            app:cardCornerRadius="@dimen/five_dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom">

                <ImageButton
                    android:layout_width="@dimen/zero_dp"
                    android:layout_weight=".15"
                    android:background="@drawable/white_circle_button"
                    android:id="@+id/comment_emoji_button"
                    app:srcCompat="@mipmap/ic_mood_white_24dp"
                    android:paddingBottom="@dimen/ten_dp"
                    android:paddingTop="@dimen/ten_dp"
                    android:layout_height="wrap_content"
                    android:tint="@color/skyblue"
                    tools:ignore="ContentDescription" />

                <com.vanniktech.emoji.EmojiEditText
                    android:layout_width="@dimen/zero_dp"
                    android:layout_weight=".80"
                    android:hint="@string/ur_opinion"
                    android:id="@+id/comment_message_field"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:background="@color/transparent"
                    android:layout_gravity="center"
                    android:paddingTop="@dimen/ten_dp"
                    android:paddingBottom="@dimen/ten_dp"
                    android:maxLines="5"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            app:cardElevation="1dp"
            android:layout_width="@dimen/zero_dp"
            android:layout_weight=".15"
            app:cardCornerRadius="@dimen/five_dp"
            android:layout_marginBottom="@dimen/one_dp"
            android:layout_marginTop="@dimen/one_dp"
            android:layout_gravity="bottom"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/comment_send_button"
                android:background="@drawable/white_circle_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@mipmap/ic_send_white_24dp"
                android:tint="@color/skyblue"
                tools:ignore="ContentDescription" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>