<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:clickable="true"
        android:focusable="true"
        android:id="@+id/storyBox"
        android:foreground="?android:attr/selectableItemBackground"
        android:layout_marginBottom="@dimen/zero_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        card_view:cardElevation="@dimen/zero_dp">

        <RelativeLayout
            android:paddingTop="@dimen/eight_dp"
            android:paddingBottom="@dimen/eight_dp"
            android:paddingRight="@dimen/ten_dp"
            android:paddingLeft="@dimen/ten_dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:id="@+id/storyPreview"
                android:scaleType="centerCrop"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/desc"/>

            <TextView
                android:id="@+id/storyDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/current_margin"
                android:layout_marginStart="@dimen/current_margin"
                android:layout_toRightOf="@+id/storyPreview"
                android:layout_toEndOf="@+id/storyPreview"
                android:layout_toLeftOf="@+id/storyRight"
                android:layout_toStartOf="@id/storyRight"/>

            <LinearLayout
                android:id="@+id/storyRight"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical">

                <ImageView
                    android:tint="@color/skyblue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_visibility_white_24dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:text="0"
                    android:id="@+id/storyViews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/three_dp"
                    android:layout_marginStart="@dimen/three_dp"
                    android:layout_marginRight="@dimen/current_margin"
                    android:layout_marginEnd="@dimen/current_margin"
                    tools:ignore="HardcodedText" />

                <ImageView
                    android:id="@+id/storyDelete"
                    android:tint="@color/skyblue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_delete_white_24dp"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>