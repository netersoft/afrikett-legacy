<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.activities.showcase_activities.overview.admin.settings.ShowcaseInfoSettingsActivity">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="@dimen/zero_dp"
        android:layout_height="@dimen/zero_dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/infoProfil"
                android:orientation="vertical"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:focusableInTouchMode="true"
                android:paddingRight="@dimen/current_margin"
                android:paddingLeft="@dimen/current_margin"
                android:layout_height="wrap_content"
                android:layout_width="match_parent">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/skyblue"
                    app:hintTextColor="@color/skyblue"
                    android:layout_marginTop="@dimen/current_margin"
                    android:layout_marginBottom="@dimen/current_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/name_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:backgroundTint="@color/skyblue"
                        android:textColor="@color/dimgray"
                        android:hint="@string/name_of_showcase" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/skyblue"
                    app:hintTextColor="@color/skyblue"
                    android:layout_marginBottom="@dimen/ten_dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:maxLength="260"
                        android:id="@+id/description_edittext"
                        android:inputType="textMultiLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:backgroundTint="@color/skyblue"
                        android:textColor="@color/dimgray"
                        android:hint="@string/description_of_showcase" />

                    <TextView
                        android:id="@+id/description_length"
                        android:textColor="@color/dimgray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/field_layout"
                    android:paddingEnd="@dimen/two_dp"
                    android:layout_width="match_parent"
                    android:paddingLeft="@dimen/two_dp"
                    android:paddingStart="@dimen/two_dp"
                    android:paddingRight="@dimen/two_dp"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/skyblue"
                    android:layout_marginTop="@dimen/five_dp"
                    android:layout_marginBottom="@dimen/current_margin">

                    <TextView
                        android:text="@string/activity_category"
                        android:textColor="@color/skyblue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/five_dp"
                        android:layout_marginBottom="@dimen/five_dp">

                        <TextView
                            android:textSize="16sp"
                            android:id="@+id/field"
                            android:textColor="@color/dimgray"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"/>

                        <ImageView
                            android:tint="@color/skyblue"
                            android:layout_centerVertical="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentRight="true"
                            android:src="@mipmap/ic_arrow_drop_down_white_24dp"
                            tools:ignore="ContentDescription" />

                    </RelativeLayout>

                    <View
                        android:layout_height="1dp"
                        android:background="@color/skyblue"
                        android:layout_width="match_parent"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/address_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/skyblue"
                    app:hintTextColor="@color/skyblue"
                    android:layout_marginBottom="@dimen/current_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:focusableInTouchMode="true"
                        android:id="@+id/address_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:backgroundTint="@color/skyblue"
                        android:textColor="@color/dimgray"
                        android:hint="@string/business_address_with_star" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/email_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/skyblue"
                    app:hintTextColor="@color/skyblue"
                    android:layout_marginBottom="@dimen/current_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:backgroundTint="@color/skyblue"
                        android:textColor="@color/dimgray"
                        android:hint="@string/email" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phone_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/skyblue"
                    app:hintTextColor="@color/skyblue"
                    android:layout_marginBottom="@dimen/current_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phone_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:backgroundTint="@color/skyblue"
                        android:textColor="@color/dimgray"
                        android:hint="@string/phone" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/website_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/skyblue"
                    app:hintTextColor="@color/skyblue"
                    android:layout_marginBottom="@dimen/current_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/website_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:backgroundTint="@color/skyblue"
                        android:textColor="@color/dimgray"
                        android:hint="@string/website" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/opening_hours_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/skyblue"
                    app:hintTextColor="@color/skyblue"
                    android:layout_marginBottom="@dimen/current_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:focusableInTouchMode="true"
                        android:id="@+id/opening_hours_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:backgroundTint="@color/skyblue"
                        android:textColor="@color/dimgray"
                        android:hint="@string/opening_hours" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>