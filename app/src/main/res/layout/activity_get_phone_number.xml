<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/skyblue"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/overlay_top"
    android:paddingEnd="@dimen/current_margin"
    android:paddingStart="@dimen/current_margin"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.activities.launch_activities.start.phone.GetPhoneNumberActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">

                <TextView
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:text="@string/enter_ur_phone_number"
                    android:layout_marginBottom="@dimen/overlay_top_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <androidx.cardview.widget.CardView
                    app:cardElevation="@dimen/zero_dp"
                    android:layout_marginRight="@dimen/current_margin"
                    android:layout_marginLeft="@dimen/current_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusableInTouchMode="true"
                        android:gravity="center_vertical">

                        <net.rimoto.intlphoneinput.IntlPhoneInput
                            android:layout_width="@dimen/zero_dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.85"
                            app:textSize="18sp"
                            app:textColor="@color/dimgray"
                            app:flagPaddingEnd="@dimen/six_dp"
                            app:flagPaddingStart="@dimen/four_dp"
                            app:flagPaddingTop="@dimen/two_dp"
                            app:flagPaddingBottom="@dimen/two_dp"
                            android:layout_marginTop="@dimen/two_dp"
                            android:layout_marginBottom="@dimen/two_dp"
                            android:id="@+id/phone_input" />

                        <ImageView
                            android:layout_width="@dimen/zero_dp"
                            android:layout_weight="0.15"
                            android:id="@+id/phone_icon"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/desc"
                            app:srcCompat="@mipmap/ic_call_white_24dp"
                            android:tint="@color/gray"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/get_phone_number_indication"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five_dp"
                    android:layout_marginBottom="@dimen/current_margin"
                    android:textColorLink="@color/aurore"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"/>

                <Button
                    android:id="@+id/next"
                    android:text="@string/next"
                    android:textColor="@color/skyblue"
                    android:layout_width="225dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/white_button"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_marginBottom="@dimen/five_dp"
                    android:layout_marginTop="@dimen/current_margin"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>