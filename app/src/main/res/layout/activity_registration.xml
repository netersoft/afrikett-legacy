<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/ten_dp"
    android:background="@color/darkorange"
    tools:context=".ui.activities.launch_activities.start.email.RegistrationActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/title"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:text="@string/Registration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:textAppearance="@style/TitleAppearance"/>

            <LinearLayout
                android:layout_width="@dimen/zero_dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/title"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:focusableInTouchMode="true"
                android:layout_marginTop="@dimen/overlay_top_2"
                android:layout_height="wrap_content"
                android:gravity="center">

                <androidx.cardview.widget.CardView
                    app:cardElevation="@dimen/zero_dp"
                    android:layout_marginTop="@dimen/three_dp"
                    android:layout_marginRight="@dimen/current_margin"
                    android:layout_marginLeft="@dimen/current_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:ems="10"
                        android:id="@+id/username"
                        android:inputType="text"
                        android:layout_margin="@dimen/one_dp"
                        android:textColor="@color/dimgray"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/complete_name"
                        app:backgroundTint="@color/white"
                        tools:ignore="Autofill" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    app:cardElevation="@dimen/zero_dp"
                    android:layout_marginTop="@dimen/three_dp"
                    android:layout_marginRight="@dimen/current_margin"
                    android:layout_marginLeft="@dimen/current_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:ems="10"
                        android:id="@+id/email"
                        android:inputType="textEmailAddress"
                        android:layout_margin="@dimen/one_dp"
                        android:textColor="@color/dimgray"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/email"
                        app:backgroundTint="@color/white"
                        tools:ignore="Autofill" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    app:cardElevation="@dimen/zero_dp"
                    android:layout_marginTop="@dimen/three_dp"
                    android:layout_marginRight="@dimen/current_margin"
                    android:layout_marginLeft="@dimen/current_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:ems="10"
                        android:id="@+id/password"
                        android:inputType="textPassword"
                        android:layout_margin="@dimen/one_dp"
                        android:textColor="@color/dimgray"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/password"
                        app:backgroundTint="@color/white"
                        tools:ignore="Autofill" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    app:cardElevation="@dimen/zero_dp"
                    android:layout_marginTop="@dimen/three_dp"
                    android:layout_marginRight="@dimen/current_margin"
                    android:layout_marginLeft="@dimen/current_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical">

                        <net.rimoto.intlphoneinput.IntlPhoneInput
                            android:layout_width="@dimen/zero_dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.85"
                            app:textSize="18sp"
                            app:textColor="@color/dimgray"
                            app:flagPaddingEnd="@dimen/six_dp"
                            app:flagPaddingStart="@dimen/four_dp"
                            app:flagPaddingTop="@dimen/two_dp"
                            app:flagPaddingBottom="@dimen/two_dp"
                            android:layout_marginTop="@dimen/two_dp"
                            android:layout_marginBottom="@dimen/two_dp"
                            android:id="@+id/phone_input" />

                        <ImageView
                            android:layout_width="@dimen/zero_dp"
                            android:id="@+id/phoneInfo"
                            android:layout_weight="0.15"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/desc"
                            app:srcCompat="@mipmap/ic_info_outline_white_24dp"
                            android:tint="@color/gray"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/register"
                    android:text="@string/toRegister"
                    android:layout_width="225dp"
                    android:textColor="@color/white"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/current_margin"
                    android:background="@drawable/white_button_bg_stroke"/>

                <TextView
                    android:id="@+id/email_registration_indication"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eight_dp"
                    android:layout_marginBottom="@dimen/current_margin"
                    android:textColorLink="@color/whitesmoke"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>