<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="?attr/actionBarSize"
    tools:context=".ui.activities.messenger_activities.ChatBoxInfoActivity">

    <RelativeLayout
        android:id="@+id/contactProfileBox"
        android:padding="@dimen/ten_dp"
        android:background="@color/whitesmoke"
        android:layout_marginTop="@dimen/current_margin"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="200dp"
        android:layout_width="@dimen/zero_dp">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:id="@+id/contactPicture"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/nav_header_desc"
            app:srcCompat="@mipmap/afrikett_launcher" />

        <TextView
            android:gravity="center"
            android:textStyle="bold"
            android:id="@+id/contactName"
            android:textColor="@color/skyblue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/contactPicture"
            android:layout_marginTop="@dimen/current_margin"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1" />

        <TextView
            android:gravity="center"
            android:id="@+id/contactNumber"
            android:textColor="@color/lightblue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/contactName"
            android:layout_marginTop="@dimen/five_dp"/>

    </RelativeLayout>

    <TextView
        android:text="@string/files"
        android:textColor="@color/lightblue"
        android:id="@+id/autoDownloadtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/current_margin"
        android:paddingRight="@dimen/current_margin"
        android:paddingTop="@dimen/ten_dp"
        android:paddingBottom="@dimen/ten_dp"
        android:paddingLeft="@dimen/current_margin"
        android:paddingStart="@dimen/current_margin"
        app:layout_constraintTop_toBottomOf="@id/contactProfileBox" />

    <RelativeLayout
        android:paddingEnd="@dimen/current_margin"
        android:paddingRight="@dimen/current_margin"
        android:paddingTop="@dimen/ten_dp"
        android:paddingBottom="@dimen/ten_dp"
        android:paddingLeft="@dimen/current_margin"
        android:paddingStart="@dimen/current_margin"
        android:id="@+id/autoDownloadBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/whitesmoke"
        app:layout_constraintTop_toBottomOf="@id/autoDownloadtitle">

        <TextView
            android:id="@+id/autoDownloadLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:text="@string/auto_download"
            android:layout_toLeftOf="@+id/autoDownloadSwitch"
            android:layout_toStartOf="@+id/autoDownloadSwitch" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="false"
            android:theme="@style/switchStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:id="@+id/autoDownloadSwitch"
            android:layout_alignParentRight="true"/>

    </RelativeLayout>

    <TextView
        android:text="@string/notifications"
        android:textColor="@color/lightblue"
        android:id="@+id/notificationsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/ten_dp"
        android:paddingBottom="@dimen/ten_dp"
        android:paddingEnd="@dimen/current_margin"
        android:paddingRight="@dimen/current_margin"
        android:paddingLeft="@dimen/current_margin"
        android:paddingStart="@dimen/current_margin"
        app:layout_constraintTop_toBottomOf="@id/autoDownloadBox" />

    <RelativeLayout
        android:paddingTop="@dimen/ten_dp"
        android:paddingBottom="@dimen/ten_dp"
        android:id="@+id/notificationsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/whitesmoke"
        android:paddingEnd="@dimen/current_margin"
        android:paddingRight="@dimen/current_margin"
        android:paddingLeft="@dimen/current_margin"
        android:paddingStart="@dimen/current_margin"
        app:layout_constraintTop_toBottomOf="@id/notificationsTitle">

        <TextView
            android:text="@string/silent_mode"
            android:id="@+id/notificationsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_toLeftOf="@+id/notificationsSwitch"
            android:layout_toStartOf="@+id/notificationsSwitch" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="false"
            android:theme="@style/switchStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:id="@+id/notificationsSwitch"
            android:layout_alignParentRight="true"/>

    </RelativeLayout>

    <TextView
        android:id="@+id/block"
        android:clickable="true"
        android:focusable="true"
        android:textColor="@color/skyblue"
        android:background="@color/whitesmoke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/current_margin"
        android:paddingBottom="@dimen/current_margin"
        android:paddingEnd="@dimen/current_margin"
        android:paddingRight="@dimen/current_margin"
        android:paddingLeft="@dimen/current_margin"
        android:paddingStart="@dimen/current_margin"
        android:layout_marginTop="@dimen/five_dp"
        app:layout_constraintTop_toBottomOf="@id/notificationsBox" />

    <TextView
        android:text="@string/report_contact"
        android:id="@+id/report"
        android:clickable="true"
        android:focusable="true"
        android:textColor="@color/red"
        android:background="@color/whitesmoke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/current_margin"
        android:paddingBottom="@dimen/current_margin"
        android:paddingEnd="@dimen/current_margin"
        android:paddingRight="@dimen/current_margin"
        android:paddingLeft="@dimen/current_margin"
        android:paddingStart="@dimen/current_margin"
        android:layout_marginTop="@dimen/five_dp"
        app:layout_constraintTop_toBottomOf="@id/block" />

</androidx.constraintlayout.widget.ConstraintLayout>