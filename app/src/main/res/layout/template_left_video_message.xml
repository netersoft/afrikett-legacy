<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_marginEnd="80dp"
        android:layout_marginRight="80dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_left"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/template_left_video_content">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/template_left_video_thumbnail"
                android:layout_width="225dp"
                android:layout_height="275dp"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <ImageView
                android:tint="@color/white"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:id="@+id/template_left_video_play_button"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/ic_play_arrow_white_48dp"
                android:background="@drawable/transparent_black_circle"
                tools:ignore="ContentDescription" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_marginLeft="@dimen/five_dp"
                android:layout_marginStart="@dimen/five_dp"
                android:id="@+id/template_left_video_center_box">

                <RelativeLayout
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginBottom="@dimen/ten_dp"
                    android:id="@+id/template_left_video_progress_box">

                    <com.dinuscxj.progressbar.CircleProgressBar
                        android:max="100"
                        app:style="solid_line"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:progress_stroke_width="1dp"
                        android:layout_centerInParent="true"
                        app:drawBackgroundOutsideProgress="true"
                        app:progress_end_color="@color/white"
                        app:progress_text_color="@color/transparent"
                        app:progress_start_color="@color/white"
                        app:progress_background_color="@color/transparent"
                        android:id="@+id/template_left_video_progress_bar"
                        android:background="@drawable/transparent_black_circle"/>

                    <ImageView
                        android:layout_width="@dimen/twelve_dp"
                        android:layout_height="@dimen/twelve_dp"
                        android:layout_centerInParent="true"
                        app:srcCompat="@mipmap/ic_clear_white_18dp"
                        android:tint="@color/white"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:padding="@dimen/five_dp"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginBottom="@dimen/ten_dp"
                    android:background="@drawable/radius_rect_transparent_black"
                    android:id="@+id/template_left_video_retry_box">

                    <ImageView
                        android:layout_gravity="start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@mipmap/ic_file_download_white_18dp"
                        android:tint="@color/white"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:text="@string/retry"
                        android:textColor="@color/white"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </RelativeLayout>

        </RelativeLayout>

        <com.neteru.afrikett.core.libs.EmojiAndSocialTextView.EmojiAndSocialTextView
            android:textColor="@color/whitesmoke"
            android:id="@+id/template_left_video_legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/three_dp"
            app:hashtagColor="@color/aurore"
            app:urlColor="@color/orange"
            app:emailColor="@color/gray"
            app:phoneColor="@color/gray"
            app:selectedColor="@color/silver"
            app:linkModes="hashtag|email|phone|url"
            android:textSize="16sp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:textSize="12sp"
                android:textColor="@color/whitesmoke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:drawablePadding="@dimen/three_dp"
                android:id="@+id/template_left_video_length"
                android:drawableLeft="@mipmap/ic_videocam_white_18dp"
                android:drawableStart="@mipmap/ic_videocam_white_18dp"
                android:layout_toStartOf="@+id/template_left_video_hour"
                android:layout_toLeftOf="@+id/template_left_video_hour"/>

            <TextView
                android:textSize="12sp"
                android:gravity="end"
                android:textColor="@color/whitesmoke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:id="@+id/template_left_video_hour"
                android:layout_marginLeft="@dimen/ten_dp"
                android:layout_marginStart="@dimen/ten_dp"
                android:layout_marginRight="@dimen/three_dp"
                android:layout_marginEnd="@dimen/three_dp"/>

        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>