<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_marginEnd="80dp"
        android:layout_marginRight="80dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_left"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/template_left_text_content">

        <com.neteru.afrikett.core.libs.EmojiAndSocialTextView.EmojiAndSocialTextView
            android:textColor="@color/whitesmoke"
            android:id="@+id/template_left_text_txt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/three_dp"
            app:hashtagColor="@color/skyblue"
            app:urlColor="@color/deepskyblue"
            app:emailColor="@color/gray"
            app:phoneColor="@color/gray"
            app:selectedColor="@color/silver"
            app:linkModes="hashtag|email|phone|url"
            android:textSize="16sp"/>

        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:textSize="12sp"
                android:layout_gravity="end"
                android:textColor="@color/whitesmoke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/template_left_text_hour"
                android:layout_marginLeft="@dimen/fifteen_dp"
                android:layout_marginStart="@dimen/fifteen_dp"
                android:layout_marginRight="@dimen/three_dp"
                android:layout_marginEnd="@dimen/three_dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>