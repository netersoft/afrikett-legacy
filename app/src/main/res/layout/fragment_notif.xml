<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/whitesmoke"
    tools:context=".ui.fragments.home_fragments.NotifFragment">

    <com.neteru.afrikett.core.libs.StateView.StateView
        android:id="@+id/status_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/overlay_top_2"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/warning_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ten_dp"
        app:cardElevation="@dimen/zero_dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/three_dp"
        app:contentPadding="@dimen/seven_dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:tint="@color/darkorange"
                android:src="@mipmap/ic_warning_white_24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/five_dp"
                android:layout_marginEnd="@dimen/five_dp"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/warning_text"
                android:textColorLink="@color/darkorange"
                android:text="@string/notification_unavailable_warning_msg"
                android:textColor="@color/dimgray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>