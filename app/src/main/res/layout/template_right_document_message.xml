<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="80dp"
    android:paddingLeft="80dp"
    android:paddingRight="@dimen/zero_dp"
    android:paddingEnd="@dimen/zero_dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/bubble_right"
        android:id="@+id/template_right_document_content">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five_dp"
            android:layout_marginBottom="@dimen/five_dp">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:padding="@dimen/ten_dp"
                android:layout_gravity="center_vertical"
                android:id="@+id/template_right_document_picture"
                android:layout_marginStart="@dimen/current_margin"
                android:layout_marginLeft="@dimen/current_margin"
                android:layout_marginRight="@dimen/current_margin"
                android:layout_marginEnd="@dimen/current_margin"
                app:srcCompat="@drawable/ic_description_white_48dp"
                android:background="@drawable/transparent_black_circle"
                tools:ignore="ContentDescription" />

            <TextView
                android:textColor="@color/white"
                android:layout_marginRight="@dimen/ten_dp"
                android:layout_marginEnd="@dimen/ten_dp"
                android:layout_gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:id="@+id/template_right_document_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/five_dp"
                android:layout_marginEnd="@dimen/five_dp"
                android:layout_gravity="center_vertical"
                android:id="@+id/template_right_document_center_box">

                <RelativeLayout
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:id="@+id/template_right_document_progress_box">

                    <com.dinuscxj.progressbar.CircleProgressBar
                        android:max="100"
                        app:style="solid_line"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:progress_stroke_width="1dp"
                        android:layout_centerInParent="true"
                        app:drawBackgroundOutsideProgress="true"
                        app:progress_end_color="@color/colorAccent"
                        app:progress_text_color="@color/transparent"
                        app:progress_start_color="@color/colorAccent"
                        app:progress_background_color="@color/transparent"
                        android:id="@+id/template_right_document_progress_bar"
                        android:background="@drawable/transparent_black_circle"/>

                    <ImageView
                        android:layout_width="@dimen/twelve_dp"
                        android:layout_height="@dimen/twelve_dp"
                        android:layout_centerInParent="true"
                        app:srcCompat="@mipmap/ic_clear_white_18dp"
                        android:tint="@color/colorAccent"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

                <ImageView
                    android:visibility="gone"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:padding="@dimen/four_dp"
                    android:tint="@color/colorAccent"
                    android:layout_centerInParent="true"
                    android:id="@+id/template_right_document_retry_box"
                    app:srcCompat="@mipmap/ic_file_upload_white_18dp"
                    android:background="@drawable/transparent_black_circle"
                    tools:ignore="ContentDescription" />

            </RelativeLayout>

        </LinearLayout>

        <View
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_marginEnd="@dimen/five_dp"
            android:layout_marginRight="@dimen/five_dp"
            android:layout_marginStart="@dimen/five_dp"
            android:layout_marginLeft="@dimen/five_dp"
            android:layout_height="0.25dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:textSize="12sp"
                android:textColor="@color/silver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:id="@+id/template_right_document_size"
                android:layout_toStartOf="@+id/hour_state_bloc"
                android:layout_toLeftOf="@+id/hour_state_bloc"/>

            <LinearLayout
                android:gravity="end"
                android:id="@+id/hour_state_bloc"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="UseCompoundDrawables">

                <TextView
                    android:textSize="12sp"
                    android:layout_gravity="end"
                    android:textColor="@color/silver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/template_right_document_hour"
                    android:layout_marginLeft="@dimen/ten_dp"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:layout_marginRight="@dimen/three_dp"
                    android:layout_marginEnd="@dimen/three_dp"/>

                <ImageView
                    android:layout_gravity="end"
                    android:id="@+id/template_right_document_state"
                    android:layout_width="@dimen/fifteen_dp"
                    android:layout_height="@dimen/fifteen_dp"
                    android:layout_marginRight="@dimen/five_dp"
                    android:layout_marginEnd="@dimen/five_dp"
                    android:paddingTop="@dimen/two_dp"
                    app:srcCompat="@mipmap/ic_schedule_white_18dp"
                    android:tint="@color/dimgray"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>