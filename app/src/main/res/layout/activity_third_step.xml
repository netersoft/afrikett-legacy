<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkorange"
    tools:context=".ui.activities.showcase_activities.registration.ThirdStepActivity">

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        app:layout_constraintTop_toTopOf="parent"
        android:indeterminate="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/progressBar"
        android:progress="3"
        android:max="4"/>

    <LinearLayout
        android:layout_width="@dimen/zero_dp"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/overlay_top_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <TextView
            android:gravity="center"
            android:textStyle="bold"
            android:text="@string/third_step_title"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.cardview.widget.CardView
            app:cardElevation="@dimen/zero_dp"
            android:layout_marginTop="@dimen/nine_dp"
            android:layout_marginRight="@dimen/current_margin"
            android:layout_marginLeft="@dimen/current_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical">

                <EditText
                    android:ems="10"
                    android:id="@+id/address"
                    android:inputType="text"
                    android:layout_weight="0.85"
                    android:layout_margin="@dimen/nine_dp"
                    android:layout_width="@dimen/zero_dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/business_address_with_star"
                    android:textColor="@color/dimgray"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    android:background="@android:color/transparent"
                    tools:ignore="Autofill" />

                <ImageView
                    android:layout_width="@dimen/zero_dp"
                    android:layout_weight="0.15"
                    android:id="@+id/address_icon"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc"
                    app:srcCompat="@mipmap/ic_place_white_24dp"
                    android:tint="@color/gray"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            app:cardElevation="@dimen/zero_dp"
            android:layout_marginTop="@dimen/five_dp"
            android:layout_marginRight="@dimen/current_margin"
            android:layout_marginLeft="@dimen/current_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical">

                <EditText
                    android:ems="10"
                    android:id="@+id/email"
                    android:layout_weight="0.85"
                    android:inputType="textEmailAddress"
                    android:layout_margin="@dimen/nine_dp"
                    android:layout_width="@dimen/zero_dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/email"
                    android:textColor="@color/dimgray"
                    android:background="@android:color/transparent"
                    tools:ignore="Autofill" />

                <ImageView
                    android:layout_width="@dimen/zero_dp"
                    android:layout_weight="0.15"
                    android:id="@+id/email_icon"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc"
                    app:srcCompat="@mipmap/baseline_email_white_24"
                    android:tint="@color/gray"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            app:cardElevation="@dimen/zero_dp"
            android:layout_marginTop="@dimen/five_dp"
            android:layout_marginRight="@dimen/current_margin"
            android:layout_marginLeft="@dimen/current_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical">

                <EditText
                    android:ems="10"
                    android:id="@+id/tel"
                    android:inputType="phone"
                    android:layout_weight="0.85"
                    android:layout_margin="@dimen/nine_dp"
                    android:layout_width="@dimen/zero_dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/phone"
                    android:textColor="@color/dimgray"
                    android:background="@android:color/transparent"
                    tools:ignore="Autofill" />

                <ImageView
                    android:layout_width="@dimen/zero_dp"
                    android:layout_weight="0.15"
                    android:id="@+id/phone_icon"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc"
                    app:srcCompat="@mipmap/ic_call_white_24dp"
                    android:tint="@color/gray"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            app:cardElevation="@dimen/zero_dp"
            android:layout_marginTop="@dimen/five_dp"
            android:layout_marginRight="@dimen/current_margin"
            android:layout_marginLeft="@dimen/current_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical">

                <EditText
                    android:ems="10"
                    android:id="@+id/website"
                    android:inputType="textUri"
                    android:layout_weight="0.85"
                    android:layout_margin="@dimen/nine_dp"
                    android:layout_width="@dimen/zero_dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/website"
                    android:textColor="@color/dimgray"
                    android:background="@android:color/transparent"
                    tools:ignore="Autofill" />

                <ImageView
                    android:layout_width="@dimen/zero_dp"
                    android:layout_weight="0.15"
                    android:id="@+id/website_icon"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc"
                    app:srcCompat="@mipmap/ic_insert_link_white_24dp"
                    android:tint="@color/gray"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <Button
        android:id="@+id/next"
        android:text="@string/next"
        android:textColor="@color/orange"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:background="@drawable/white_button"
        style="?android:attr/borderlessButtonStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginBottom="@dimen/five_dp"
        android:layout_marginRight="@dimen/current_margin"
        android:layout_marginEnd="@dimen/current_margin"/>

</androidx.constraintlayout.widget.ConstraintLayout>