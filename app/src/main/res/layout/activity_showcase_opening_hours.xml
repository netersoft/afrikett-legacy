<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.activities.showcase_activities.overview.admin.settings.sub_settings.ShowcaseOpeningHoursActivity">

    <com.google.android.material.appbar.AppBarLayout
        app:layout_constraintTop_toTopOf="parent"
        app:elevation="@dimen/zero_dp"
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:popupTheme="@style/AppTheme.PopupOverlay"/>

    </com.google.android.material.appbar.AppBarLayout>

    <RadioGroup
        android:id="@+id/header_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/app_bar_layout">

        <androidx.appcompat.widget.AppCompatRadioButton
            android:textColor="@color/dimgray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/current_margin"
            android:layout_marginStart="@dimen/current_margin"
            android:layout_marginLeft="@dimen/current_margin"
            android:text="@string/always_open"
            android:id="@+id/option_1"
            android:checked="false"
            app:buttonTint="@color/skyblue"/>

        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>

        <androidx.appcompat.widget.AppCompatRadioButton
            android:textColor="@color/dimgray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/current_margin"
            android:layout_marginStart="@dimen/current_margin"
            android:layout_marginLeft="@dimen/current_margin"
            android:text="@string/no_schedule_available"
            android:id="@+id/option_2"
            android:checked="false"
            app:buttonTint="@color/skyblue"/>

        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>

        <androidx.appcompat.widget.AppCompatRadioButton
            android:textColor="@color/dimgray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/current_margin"
            android:layout_marginStart="@dimen/current_margin"
            android:layout_marginLeft="@dimen/current_margin"
            android:text="@string/open_at_certain_hours"
            android:id="@+id/option_3"
            android:checked="false"
            app:buttonTint="@color/skyblue"/>

    </RadioGroup>

    <LinearLayout
        app:layout_constraintTop_toBottomOf="@+id/header_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/current_margin"
        android:layout_marginRight="@dimen/current_margin"
        android:orientation="vertical"
        android:id="@+id/sub_group">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/current_margin"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/monday"
                android:id="@+id/monday"
                android:checked="false"
                app:buttonTint="@color/skyblue"/>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                tools:ignore="RelativeOverlap">

                <EditText
                    android:enabled="false"
                    android:id="@+id/monday_start_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

                <TextView
                    android:text="@string/dash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <EditText
                    android:enabled="false"
                    android:id="@+id/monday_end_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

            </LinearLayout>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/current_margin"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/tuesday"
                android:id="@+id/tuesday"
                android:checked="false"
                app:buttonTint="@color/skyblue"/>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                tools:ignore="RelativeOverlap">

                <EditText
                    android:enabled="false"
                    android:id="@+id/tuesday_start_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

                <TextView
                    android:text="@string/dash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <EditText
                    android:enabled="false"
                    android:id="@+id/tuesday_end_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

            </LinearLayout>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/current_margin"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/wednesday"
                android:id="@+id/wednesday"
                android:checked="false"
                app:buttonTint="@color/skyblue"/>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                tools:ignore="RelativeOverlap">

                <EditText
                    android:enabled="false"
                    android:id="@+id/wednesday_start_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

                <TextView
                    android:text="@string/dash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <EditText
                    android:enabled="false"
                    android:id="@+id/wednesday_end_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

            </LinearLayout>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/current_margin"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/thursday"
                android:id="@+id/thursday"
                android:checked="false"
                app:buttonTint="@color/skyblue"/>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                tools:ignore="RelativeOverlap">

                <EditText
                    android:enabled="false"
                    android:id="@+id/thursday_start_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

                <TextView
                    android:text="@string/dash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <EditText
                    android:enabled="false"
                    android:id="@+id/thursday_end_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

            </LinearLayout>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/current_margin"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/friday"
                android:id="@+id/friday"
                android:checked="false"
                app:buttonTint="@color/skyblue"/>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                tools:ignore="RelativeOverlap">

                <EditText
                    android:enabled="false"
                    android:id="@+id/friday_start_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

                <TextView
                    android:text="@string/dash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <EditText
                    android:enabled="false"
                    android:id="@+id/friday_end_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

            </LinearLayout>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/current_margin"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/saturday"
                android:id="@+id/saturday"
                android:checked="false"
                app:buttonTint="@color/skyblue"/>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                tools:ignore="RelativeOverlap">

                <EditText
                    android:enabled="false"
                    android:id="@+id/saturday_start_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

                <TextView
                    android:text="@string/dash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <EditText
                    android:enabled="false"
                    android:id="@+id/saturday_end_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

            </LinearLayout>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/current_margin"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/sunday"
                android:id="@+id/sunday"
                android:checked="false"
                app:buttonTint="@color/skyblue"/>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                tools:ignore="RelativeOverlap">

                <EditText
                    android:enabled="false"
                    android:id="@+id/sunday_start_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

                <TextView
                    android:text="@string/dash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <EditText
                    android:enabled="false"
                    android:id="@+id/sunday_end_hour"
                    android:inputType="text"
                    android:hint="@string/hour"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:focusableInTouchMode="true"
                    tools:ignore="Autofill" />

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>