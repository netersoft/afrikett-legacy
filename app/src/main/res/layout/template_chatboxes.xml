<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:clickable="true"
        android:focusable="true"
        android:id="@+id/chatBox"
        android:foreground="?android:attr/selectableItemBackground"
        android:layout_marginBottom="@dimen/zero_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        card_view:cardElevation="@dimen/zero_dp">

        <LinearLayout
            android:paddingTop="@dimen/eight_dp"
            android:paddingBottom="@dimen/eight_dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:id="@+id/chatBoxImg"
                android:scaleType="centerCrop"
                android:contentDescription="@string/desc"
                android:layout_marginLeft="@dimen/ten_dp"
                android:layout_marginStart="@dimen/ten_dp"/>

            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="2.5dp"
                android:paddingBottom="2.5dp"
                android:layout_marginLeft="@dimen/ten_dp"
                android:layout_marginStart="@dimen/ten_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/chatBoxName"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentStart="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/chatBoxLastTime"
                        android:layout_toLeftOf="@+id/chatBoxLastTime"/>

                    <TextView
                        android:textSize="13sp"
                        android:layout_marginEnd="@dimen/ten_dp"
                        android:layout_marginRight="@dimen/ten_dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/chatBoxLastTime"/>

                </RelativeLayout>

                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/gray"
                    android:id="@+id/chatBoxLastMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>