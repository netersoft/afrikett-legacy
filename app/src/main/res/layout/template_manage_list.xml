<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/showcase_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        card_view:cardBackgroundColor="@color/gray"
        card_view:cardUseCompatPadding="true"
        card_view:cardPreventCornerOverlap="true"
        card_view:cardCornerRadius="@dimen/one_dp"
        card_view:cardElevation="@dimen/zero_dp"
        card_view:contentPadding="0.5dp">

        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:id="@+id/showcase_banner"
                android:layout_width="match_parent"
                android:contentDescription="@string/banner"
                android:background="@color/silver"/>

            <TextView
                android:gravity="center"
                android:id="@+id/showcase_name"
                android:padding="@dimen/three_dp"
                android:textColor="@color/dimgray"
                android:background="@drawable/top_left_radius_rect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/showcase_logo"
                android:layout_toEndOf="@+id/showcase_logo"
                android:layout_alignRight="@+id/showcase_banner"
                android:layout_alignEnd="@+id/showcase_banner"
                android:layout_alignBottom="@+id/showcase_banner"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"/>

            <ImageView
                android:padding="@dimen/two_dp"
                android:id="@+id/showcase_logo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:background="@drawable/silver_circle"
                android:contentDescription="@string/logo"
                android:layout_marginTop="60dp"
                android:layout_marginStart="@dimen/current_margin"
                android:layout_marginLeft="@dimen/current_margin"
                android:layout_marginEnd="@dimen/current_margin"
                android:layout_marginRight="@dimen/current_margin"/>

            <RelativeLayout
                android:id="@+id/showcase_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/current_margin"
                android:layout_marginLeft="@dimen/current_margin"
                android:layout_marginEnd="@dimen/current_margin"
                android:layout_marginRight="@dimen/current_margin"
                android:layout_below="@+id/showcase_logo">

                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/darkgray"
                    android:id="@+id/showcase_subscribers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/three_dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_toLeftOf="@+id/showcase_managers"
                    android:layout_toStartOf="@+id/showcase_managers"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/darkgray"
                    android:id="@+id/showcase_managers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/three_dp"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

            </RelativeLayout>

            <TextView
                android:id="@+id/showcase_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/showcase_info"
                android:layout_marginTop="@dimen/current_margin"
                android:layout_marginStart="@dimen/current_margin"
                android:layout_marginLeft="@dimen/current_margin"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

            <TextView
                android:gravity="center"
                android:textColor="@color/silver"
                android:id="@+id/showcase_registration_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/current_margin"
                android:layout_marginBottom="@dimen/five_dp"
                android:layout_below="@+id/showcase_description"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

            <View
                android:id="@+id/showcase_bottom"
                android:layout_below="@id/showcase_registration_date"
                android:layout_alignParentBottom="true"
                android:background="@color/orange"
                android:layout_width="match_parent"
                android:layout_height="5dp"/>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>