<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.activities.showcase_activities.posts.PostActivity">

    <com.google.android.material.appbar.AppBarLayout
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:popupTheme="@style/AppTheme.PopupOverlay">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/post"
                    android:padding="@dimen/five_dp"
                    android:textColor="@color/gray"
                    android:textAllCaps="false"
                    android:text="@string/publish"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/current_margin"
                    android:layout_marginRight="@dimen/current_margin"
                    android:background="@drawable/gray_button_bg_stroke"/>

            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/actionBarSize"
        android:paddingEnd="@dimen/current_margin"
        android:paddingStart="@dimen/current_margin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/selector"
                android:paddingEnd="@dimen/two_dp"
                android:layout_width="match_parent"
                android:paddingLeft="@dimen/two_dp"
                android:paddingStart="@dimen/two_dp"
                android:paddingRight="@dimen/two_dp"
                android:layout_height="wrap_content"
                android:textColorHint="@color/skyblue"
                android:layout_marginTop="@dimen/five_dp"
                android:layout_marginBottom="@dimen/current_margin"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:textColor="@color/skyblue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/publication_selector_label"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five_dp"
                    android:layout_marginBottom="@dimen/five_dp">

                    <TextView
                        android:textSize="18sp"
                        android:id="@+id/selectorText"
                        android:layout_centerVertical="true"
                        android:textColor="@color/dimgray"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentStart="true"/>

                    <ImageView
                        android:tint="@color/skyblue"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:src="@mipmap/ic_arrow_drop_down_white_24dp"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

                <View
                    android:layout_height="1dp"
                    android:background="@color/skyblue"
                    android:layout_width="match_parent"/>

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/previews"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/current_margin"
                app:layout_constraintTop_toBottomOf="@+id/selector">

                <Button
                    android:id="@+id/add_images"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/skyblue"
                    android:text="@string/add_previews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/five_dp"
                    android:drawableLeft="@mipmap/ic_image_white_24dp"
                    android:drawableStart="@mipmap/ic_image_white_24dp"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:visibility="gone"
                    android:id="@+id/postImgRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxes"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/previews">

                <LinearLayout
                    android:id="@+id/product_and_service_box"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/skyblue"
                        app:hintTextColor="@color/skyblue"
                        android:layout_marginBottom="@dimen/five_dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/product_or_service_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:backgroundTint="@color/skyblue"
                            android:textColor="@color/dimgray"
                            android:hint="@string/name" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/skyblue"
                        app:hintTextColor="@color/skyblue"
                        android:layout_marginBottom="@dimen/five_dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/product_or_service_description"
                            android:inputType="textMultiLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:backgroundTint="@color/skyblue"
                            android:textColor="@color/dimgray"
                            android:hint="@string/description_and_details" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_weight="0.95"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColorHint="@color/skyblue"
                            app:hintTextColor="@color/skyblue"
                            android:layout_marginBottom="@dimen/five_dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:textSize="18sp"
                                android:id="@+id/product_or_service_price"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:backgroundTint="@color/skyblue"
                                android:textColor="@color/dimgray"
                                android:inputType="numberDecimal"
                                android:hint="@string/price" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:text="@string/fcfa"
                            android:textSize="18sp"
                            android:layout_weight="0.05"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/activity_vertical_margin">

                        <TextView
                            android:text="@string/availability"
                            android:layout_toLeftOf="@+id/product_or_service_availability"
                            android:layout_toStartOf="@+id/product_or_service_availability"
                            android:textAppearance="?android:attr/textAppearanceMedium"
                            android:textColor="@color/skyblue"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/product_or_service_availability"
                            app:showText="false"
                            android:checked="true"
                            app:thumbTint="@color/skyblue"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentEnd="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleX="1"
                            android:scaleY="1"/>

                    </RelativeLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/event_box"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/skyblue"
                        app:hintTextColor="@color/skyblue"
                        android:layout_marginBottom="@dimen/five_dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/event_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:backgroundTint="@color/skyblue"
                            android:textColor="@color/dimgray"
                            android:hint="@string/event_name" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/skyblue"
                        app:hintTextColor="@color/skyblue"
                        android:layout_marginBottom="@dimen/five_dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/event_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:backgroundTint="@color/skyblue"
                            android:textColor="@color/dimgray"
                            android:hint="@string/event_location" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_weight="0.5"
                            android:id="@+id/event_date_layout"
                            android:paddingEnd="@dimen/two_dp"
                            android:layout_width="wrap_content"
                            android:paddingLeft="@dimen/two_dp"
                            android:paddingStart="@dimen/two_dp"
                            android:paddingRight="@dimen/two_dp"
                            android:layout_height="wrap_content"
                            android:textColorHint="@color/skyblue"
                            android:layout_marginTop="@dimen/five_dp"
                            android:layout_marginBottom="@dimen/current_margin">

                            <TextView
                                android:text="@string/event_date"
                                android:textColor="@color/skyblue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/five_dp"
                                android:layout_marginBottom="@dimen/five_dp">

                                <TextView
                                    android:textSize="16sp"
                                    android:id="@+id/event_date"
                                    android:textColor="@color/dimgray"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentLeft="true"
                                    android:layout_alignParentStart="true"
                                    android:text="@string/add"/>

                                <ImageView
                                    android:tint="@color/skyblue"
                                    android:layout_centerVertical="true"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentRight="true"
                                    android:src="@mipmap/ic_arrow_drop_down_white_24dp"
                                    tools:ignore="ContentDescription" />

                            </RelativeLayout>

                            <View
                                android:layout_height="1dp"
                                android:background="@color/skyblue"
                                android:layout_width="match_parent"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_weight="0.5"
                            android:id="@+id/event_hour_layout"
                            android:paddingEnd="@dimen/two_dp"
                            android:layout_width="wrap_content"
                            android:paddingLeft="@dimen/two_dp"
                            android:paddingStart="@dimen/two_dp"
                            android:paddingRight="@dimen/two_dp"
                            android:layout_height="wrap_content"
                            android:textColorHint="@color/skyblue"
                            android:layout_marginTop="@dimen/five_dp"
                            android:layout_marginBottom="@dimen/current_margin">

                            <TextView
                                android:text="@string/event_hour"
                                android:textColor="@color/skyblue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/five_dp"
                                android:layout_marginBottom="@dimen/five_dp">

                                <TextView
                                    android:textSize="16sp"
                                    android:id="@+id/event_hour"
                                    android:textColor="@color/dimgray"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentLeft="true"
                                    android:layout_alignParentStart="true"
                                    android:text="@string/add"/>

                                <ImageView
                                    android:tint="@color/skyblue"
                                    android:layout_centerVertical="true"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentRight="true"
                                    android:src="@mipmap/ic_arrow_drop_down_white_24dp"
                                    tools:ignore="ContentDescription" />

                            </RelativeLayout>

                            <View
                                android:layout_height="1dp"
                                android:background="@color/skyblue"
                                android:layout_width="match_parent"/>

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/skyblue"
                        app:hintTextColor="@color/skyblue"
                        android:layout_marginBottom="@dimen/five_dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/about_event"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:backgroundTint="@color/skyblue"
                            android:textColor="@color/dimgray"
                            android:hint="@string/about_event" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/news_box"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/skyblue"
                        app:hintTextColor="@color/skyblue"
                        android:layout_marginBottom="@dimen/five_dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/news_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:backgroundTint="@color/skyblue"
                            android:textColor="@color/dimgray"
                            android:hint="@string/title" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/skyblue"
                        app:hintTextColor="@color/skyblue"
                        android:layout_marginBottom="@dimen/five_dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/news_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:backgroundTint="@color/skyblue"
                            android:textColor="@color/dimgray"
                            android:hint="@string/content" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>