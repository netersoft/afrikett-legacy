<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/whitesmoke"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.activities.showcase_activities.overview.AdminOverviewActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:fitsSystemWindows="true"
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:contentScrim="?attr/colorPrimary"
            app:expandedTitleMarginEnd="64dp"
            app:expandedTitleMarginStart="48dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <ImageView
                android:id="@+id/showcase_banner"
                android:layout_width="match_parent"
                app:layout_collapseMode="parallax"
                android:scaleType="centerCrop"
                android:layout_height="100dp"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:orientation="vertical"
                app:layout_collapseMode="parallax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/ten_dp"
                    android:paddingStart="@dimen/ten_dp"
                    android:paddingRight="@dimen/ten_dp"
                    android:paddingEnd="@dimen/ten_dp"
                    android:layout_marginTop="60dp">

                    <ImageView
                        android:padding="@dimen/two_dp"
                        android:id="@+id/showcase_logo"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:scaleType="centerCrop"
                        tools:ignore="ContentDescription"
                        app:layout_collapseMode="parallax"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/silver_circle"/>

                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_alignBottom="@+id/showcase_logo"
                        tools:ignore="RelativeOverlap">

                        <ImageButton
                            android:id="@+id/showcase_notifications"
                            android:background="@drawable/gray_button_bg_stroke"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:tint="@color/dimgray"
                            android:layout_marginRight="@dimen/five_dp"
                            android:layout_marginEnd="@dimen/five_dp"
                            android:src="@mipmap/ic_notifications_white_24dp"
                            tools:ignore="ContentDescription" />

                        <Button
                            android:id="@+id/showcase_settings"
                            android:background="@drawable/gray_button_bg_stroke"
                            android:textAllCaps="false"
                            android:paddingLeft="@dimen/ten_dp"
                            android:paddingRight="@dimen/ten_dp"
                            android:text="@string/settings"
                            android:textColor="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"/>

                    </LinearLayout>

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/showcase_info"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/ten_dp"
                    android:paddingStart="@dimen/ten_dp"
                    android:paddingEnd="@dimen/ten_dp"
                    android:paddingRight="@dimen/ten_dp"
                    android:layout_marginBottom="@dimen/ten_dp"
                    android:background="@color/white">

                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/showcase_name"
                        android:layout_marginBottom="@dimen/five_dp"
                        android:textColor="@color/dimgray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceLarge"/>

                    <LinearLayout
                        android:id="@+id/showcase_field_layout"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/five_dp"
                        android:gravity="center_vertical"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:id="@+id/showcase_field_indicator"
                            android:tint="@color/dimgray"
                            app:srcCompat="@mipmap/baseline_arrow_right_white_18"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/showcase_field"
                            android:textColor="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                    </LinearLayout>

                    <com.neteru.afrikett.core.libs.EmojiAndSocialTextView.EmojiAndSocialTextView
                        android:id="@+id/showcase_description"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceSmall"/>

                </LinearLayout>

                <HorizontalScrollView
                    android:scrollbars="none"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/three_dp"
                    android:paddingLeft="@dimen/three_dp"
                    android:paddingEnd="@dimen/three_dp"
                    android:paddingRight="@dimen/three_dp"
                    android:layout_marginTop="@dimen/three_dp"
                    android:layout_marginBottom="@dimen/seven_dp">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/showcase_address"
                            android:textColor="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/ten_dp"
                            android:layout_marginRight="@dimen/ten_dp"
                            android:drawableLeft="@mipmap/ic_place_white_24dp"
                            android:drawableStart="@mipmap/ic_place_white_24dp"
                            android:drawablePadding="@dimen/one_dp"
                            android:gravity="bottom"
                            android:textAppearance="?android:attr/textAppearanceSmall"/>

                        <TextView
                            android:id="@+id/showcase_website"
                            android:textColor="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/ten_dp"
                            android:layout_marginRight="@dimen/ten_dp"
                            android:drawableLeft="@mipmap/ic_insert_link_white_24dp"
                            android:drawableStart="@mipmap/ic_insert_link_white_24dp"
                            android:drawablePadding="@dimen/one_dp"
                            android:textAppearance="?android:attr/textAppearanceSmall"/>

                        <TextView
                            android:id="@+id/showcase_email"
                            android:textColor="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/ten_dp"
                            android:layout_marginRight="@dimen/ten_dp"
                            android:drawableLeft="@mipmap/baseline_email_white_24"
                            android:drawableStart="@mipmap/baseline_email_white_24"
                            android:drawablePadding="@dimen/one_dp"
                            android:textAppearance="?android:attr/textAppearanceSmall"/>

                        <TextView
                            android:id="@+id/showcase_phone"
                            android:textColor="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/ten_dp"
                            android:layout_marginRight="@dimen/ten_dp"
                            android:drawableLeft="@mipmap/ic_call_white_24dp"
                            android:drawableStart="@mipmap/ic_call_white_24dp"
                            android:drawablePadding="@dimen/one_dp"
                            android:textAppearance="?android:attr/textAppearanceSmall"/>

                        <TextView
                            android:id="@+id/showcase_opening_hours"
                            android:textColor="@color/dimgray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/ten_dp"
                            android:layout_marginRight="@dimen/ten_dp"
                            android:drawableLeft="@mipmap/ic_schedule_white_24dp"
                            android:drawableStart="@mipmap/ic_schedule_white_24dp"
                            android:drawablePadding="@dimen/one_dp"
                            android:textAppearance="?android:attr/textAppearanceSmall"/>

                    </LinearLayout>

                </HorizontalScrollView>

                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/ten_dp"
                    android:paddingStart="@dimen/ten_dp"
                    android:paddingEnd="@dimen/ten_dp"
                    android:paddingRight="@dimen/ten_dp"
                    android:paddingBottom="@dimen/five_dp"
                    android:paddingTop="@dimen/five_dp"
                    android:layout_marginTop="@dimen/five_dp"
                    android:background="@color/whitesmoke"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:textColor="@color/dimgray"
                        android:layout_marginStart="@dimen/one_dp"
                        android:layout_marginLeft="@dimen/one_dp"
                        android:layout_marginRight="@dimen/five_dp"
                        android:layout_marginEnd="@dimen/five_dp"
                        android:id="@+id/showcase_subscribers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"/>

                    <TextView
                        android:textColor="@color/dimgray"
                        android:layout_marginLeft="@dimen/five_dp"
                        android:layout_marginStart="@dimen/five_dp"
                        android:id="@+id/showcase_posts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:background="@color/white"
                    android:id="@+id/showcase_stories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/ten_dp"
                    android:paddingBottom="@dimen/ten_dp" />

            </LinearLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                app:layout_collapseMode="pin"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light" >

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/toolbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Widget.AppCompat.Toolbar.Title"/>

                    <TextView
                        android:id="@+id/toolbar_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                </LinearLayout>

            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabBackground="@color/whitesmoke"
            app:tabTextColor="@color/dimgray"
            app:tabMode="scrollable"
            app:tabGravity="fill" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:background="@color/orange"
        app:srcCompat="@mipmap/ic_add_white_24dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>