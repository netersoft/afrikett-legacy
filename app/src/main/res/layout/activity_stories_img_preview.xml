<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:id="@+id/rootLayout"
    tools:context=".ui.activities.showcase_activities.stories.StoriesImgPreviewActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:background="@null"
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:layout_constraintTop_toTopOf="parent"
        app:elevation="@dimen/zero_dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/AppTheme.PopupOverlay">

            <RelativeLayout
                android:id="@+id/image_preview_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/toolbar_profile_picture"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/nav_header_desc"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/current_margin"
                    android:layout_marginRight="@dimen/current_margin"
                    tools:ignore="RelativeOverlap,UseCompoundDrawables">

                    <ImageView
                        android:id="@+id/toolbar_modify_but"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@mipmap/ic_crop_rotate_white_24dp"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:layout_marginLeft="@dimen/current_margin_2"
                        android:layout_marginStart="@dimen/current_margin_2"
                        android:id="@+id/toolbar_edit_but"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@mipmap/ic_create_white_24dp"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <com.ortiz.touchview.TouchImageView
        android:layout_centerInParent="true"
        android:id="@+id/imageView"
        android:scaleType="fitCenter"
        android:layout_width="@dimen/zero_dp"
        android:layout_height="@dimen/zero_dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparentBlack"
        android:layout_marginBottom="@dimen/five_dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomEditor"/>

    <LinearLayout
        android:gravity="end"
        android:id="@+id/bottomEditor"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/five_dp"
        android:paddingStart="@dimen/five_dp"
        android:paddingEnd="@dimen/five_dp"
        android:paddingRight="@dimen/five_dp"
        android:layout_marginBottom="@dimen/eight_dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.cardview.widget.CardView
            app:cardElevation="1dp"
            android:layout_width="100dp"
            app:cardCornerRadius="@dimen/five_dp"
            app:cardBackgroundColor="@color/skyblue"
            android:layout_marginBottom="@dimen/one_dp"
            android:layout_marginTop="@dimen/one_dp"
            android:layout_gravity="bottom"
            android:layout_height="45dp">

            <ImageButton
                android:background="@color/skyblue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/img_preview_send_button"
                app:srcCompat="@mipmap/ic_send_white_24dp"
                android:tint="@color/white"
                tools:ignore="ContentDescription" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>